{
  "id": "ghost-writer-sentence-completion",
  "name": "Sentence Completion Assistant",
  "version": "1.0.0",
  "description": "Provides intelligent sentence completions as the user types",
  "enabled": true,
  "trigger": {
    "type": "typing",
    "conditions": {
      "minCharacters": 2,
      "debounceMs": 300,
      "excludePatterns": ["^\\s*$", "^[0-9]+$"],
      "activeComponents": ["GhostWriter", "WritingEditor"]
    }
  },
  "agent": {
    "type": "ghost-writer",
    "mode": "completion",
    "model": "gemini-pro",
    "temperature": 0.7,
    "maxTokens": 100
  },
  "behavior": {
    "action": "suggest-completion",
    "displayMode": "inline-ghost-text",
    "autoAccept": false,
    "acceptKeys": ["Tab", "ArrowRight"],
    "dismissKeys": ["Escape"],
    "maxSuggestions": 3,
    "rankingStrategy": "relevance"
  },
  "context": {
    "includeCurrentSentence": true,
    "includePreviousSentences": 3,
    "includeDocumentMetadata": true,
    "includeWritingStyle": true
  },
  "prompt": {
    "system": "You are a ghostly writing assistant. Complete the user's sentence naturally, matching their writing style and tone. Provide 1-3 completion options that flow seamlessly from their current text. Be creative but contextually appropriate.",
    "template": "Current text: {{currentText}}\n\nPrevious context: {{previousContext}}\n\nWriting style: {{writingStyle}}\n\nProvide natural sentence completions:"
  },
  "ui": {
    "showIndicator": true,
    "indicatorPosition": "cursor",
    "ghostTextColor": "rgba(138, 43, 226, 0.5)",
    "animationDuration": 200,
    "fadeIn": true
  },
  "performance": {
    "cacheResults": true,
    "cacheDuration": 300000,
    "maxConcurrentRequests": 1,
    "cancelPreviousOnNew": true,
    "throttleMs": 500
  },
  "analytics": {
    "trackAcceptance": true,
    "trackDismissal": true,
    "trackTypingSpeed": true,
    "trackCompletionQuality": true
  }
}
