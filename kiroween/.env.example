# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
# Get these values from Firebase Console > Project Settings > General

# Required Firebase variables
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional Firebase variables
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# OpenRouter API Configuration (for Ghost Writer AI features)
# Get your API key from https://openrouter.ai/
VITE_OPENROUTER_API_KEY=your-openrouter-api-key-here

# Development flags (optional)
# Set to 'true' to bypass authentication in development (NOT RECOMMENDED for production)
VITE_BYPASS_AUTH=false
