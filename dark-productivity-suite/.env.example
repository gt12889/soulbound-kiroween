# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
# Get these values from Firebase Console > Project Settings > General

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# OAuth Configuration
# Google OAuth - Get from Google Cloud Console > APIs & Services > Credentials
# Note: Google OAuth is configured through Firebase Console, no additional client ID needed here
# GitHub OAuth - Get from GitHub Settings > Developer settings > OAuth Apps

# GitHub OAuth Client ID (if using GitHub authentication)
# Get this from: https://github.com/settings/developers
# Create a new OAuth App and copy the Client ID
# Note: Client Secret should be configured in Firebase Console, not here
VITE_GITHUB_OAUTH_CLIENT_ID=your_github_client_id_here

# Production URLs
# Update these with your actual production domain
VITE_APP_URL=https://your-domain.com
VITE_API_URL=https://your-domain.com/api

# Optional: reCAPTCHA Site Key for App Check (recommended for production)
# Get from Firebase Console > App Check
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# AI Service Configuration (Ghost Writer Feature)
# Choose ONE provider and configure its API key below

# Option 1: Google Gemini (RECOMMENDED - Free Tier Available)
# Get from: https://makersuite.google.com/app/apikey
# Google's advanced language model with generous free tier for creative writing
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_AI_PROVIDER=gemini

# Option 2: OpenRouter (Multiple Models)
# Get from: https://openrouter.ai/keys
# Supports NVIDIA, Meta, Anthropic, and other AI models through a unified API
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
# VITE_AI_PROVIDER=openrouter

# Option 3: OpenAI (GPT Models)
# Get from: https://platform.openai.com/api-keys
# Use the same key variable as OpenRouter
# VITE_OPENROUTER_API_KEY=your_openai_api_key_here
# VITE_AI_PROVIDER=openai

# AI Model Selection
# OpenRouter models (recommended):
#   - nvidia/llama-3.1-nemotron-70b-instruct (default, high quality)
#   - nvidia/llama-3.1-nemotron-51b-instruct (faster, good quality)
#   - anthropic/claude-3.5-sonnet (premium)
#   - meta-llama/llama-3.1-70b-instruct (open source)
# OpenAI models:
#   - gpt-3.5-turbo
#   - gpt-4
# Google Gemini models:
#   - gemini-1.5-flash (default, fast and efficient)
#   - gemini-1.5-pro (more capable, slower)
#   - gemini-pro (legacy model)
VITE_AI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
